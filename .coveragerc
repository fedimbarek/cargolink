[run]
source = .
branch = True
omit =
    */migrations/*
    */tests.py
    users/testing.py
    manage.py
    config/asgi.py
    config/wsgi.py
    .venv/*
    venv/*
    staticfiles/*

[report]
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:
